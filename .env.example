# ── Copy this file to .env and fill in real values ──
# NEVER commit .env — it is gitignored (see .gitignore line 27)

# ── Required ──
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET_KEY=generate_a_random_32+_char_string_here

# ── Database ──
# Leave DATABASE_URL empty to use SQLite (DB_FILE below)
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_URL=
DB_FILE=api/cv.db

# ── CORS ──
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Environment ──
ENV=development

# ── Admin (only for first-boot account creation) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_in_production

# ── AI Provider Chain (ordered fallback) ──
AI_PROVIDERS=gemini,openai

# OpenAI-compatible (works with OpenAI, Groq, Together, Ollama, etc.)
# OPENAI_API_KEY=your_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Email (OTP + password reset) ──
# Gmail: use a Google App Password (16 chars), not your login password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
# SMTP_FROM_NAME=SkillPath
# SMTP_STARTTLS=false
